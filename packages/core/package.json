  },
  "devDependencies": {
    "@datagsm/eslint-config": "workspace:*",
    "@datagsm/typescript-config": "workspace:*",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "typescript": "7.0.2"
