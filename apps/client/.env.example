API_BASE_URL=http://localhost:8080

# 사이드바에서 다른 앱으로 이동할 주소다. 운영은 https://datagsm.kr, https://docs.datagsm.kr 처럼 넣는다.
APP_CLIENT_URL=http://localhost:3000
APP_DOCS_URL=http://localhost:3002
APP_STATUS_URL=http://localhost:3003
APP_PROJECTS_URL=http://localhost:3005

# 로그인에 쓰는 OAuth 값이다. 인가 서버 주소와 client 정보는 서버에서만 쓰며 브라우저에 보내지 않는다.
# 인가 서버의 client에 이 앱의 콜백 주소(<앱 주소>/api/callback)가 등록돼 있어야 한다.
OAUTH_AUTHORIZATION_BASE_URL=http://localhost:8083
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
